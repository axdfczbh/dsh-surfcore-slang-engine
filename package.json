{
    "name": "dsh-surfcore-slang-engine",
    "version": "0.1.1",
    "description": "DeepSeek 网络用语学习引擎：基于 SurfCore 运行，把原来的网络用语学习逻辑改为插件统一管理——QQ 与 B站 同库分页、默认按需查询、两道门与同族限制入库、自动确认/研究/设置页。本作品由 AX's deepseek 制作，AXdfczbh 提供设想；只是对现有逻辑做了符合制造者口味的修改，请勿与原插件功能攀比，涉侵权请联系删除。",
    "type": "module",
    "license": "MIT",
    "icon": "icon.png",
    "author": "AX's DeepSeek",
    "contributors": [
        "AXdfczbh"
    ],
    "keywords": [
        "dsh",
        "dsh-plugin",
        "dsh-bundle",
        "deepseek-harness",
        "cordis",
        "slang",
        "surfcore",
        "黑话"
    ],
    "engines": {
        "node": ">=20"
    },
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.png"
    },
    "files": [
        "index.js",
        "client.js",
        "lib",
        "mcp-slang.mjs",
        "scripts",
        "cordis.patch.yml",
        "locale/*.json",
        "icon.png",
        "README.md",
        "test",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axdfczbh/dsh-surfcore-slang-engine.git"
    },
    "homepage": "https://github.com/axdfczbh/dsh-surfcore-slang-engine#readme",
    "bugs": {
        "url": "https://github.com/axdfczbh/dsh-surfcore-slang-engine/issues"
    }
}
